# Copy to .env and adjust. The .env file lives in the repository root and is
# read by the server process and by drizzle-kit.

NODE_ENV=development

# Port of the single process that serves the API and, in production, the SPA.
PORT=3000

# Postgres from docker-compose.yml. Host port 55432 is deliberately far away
# from 5432/5433 so it cannot clash with another local Postgres.
DATABASE_URL=postgres://praxi:praxi@localhost:55432/praxi

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Where note attachments and, from slice 6, generated invoice PDFs live.
# Outside the web root and never served statically. A relative value is
# resolved against the repository root; an absolute one moves the whole store
# elsewhere — a mounted volume on a server, say — without touching a single
# stored path, because they are all relative to this directory.
DATA_DIR=apps/server/data

# Read by `pnpm db:seed` only. The seed creates the one tenant, its practice
# settings and this one user; it refuses to run on an empty password and never
# overwrites the password of a user that already exists.
SEED_USER_EMAIL=behandler@praxi.invalid
SEED_USER_NAME=Test Behandler
# At least 12 characters. Choose your own before seeding.
SEED_USER_PASSWORD=

# ── Google Calendar (slice 9) ────────────────────────────────────────────────
# All optional. Without them the server starts normally and everything except
# the Google area works; the settings then say "not set up" rather than
# offering a button that cannot work.
#
# Client id and secret come from a Google Cloud project with the Calendar API
# enabled, OAuth client type "Desktop app". The scopes requested are
# calendar.events, calendar.freebusy and calendar.calendarlist.readonly —
# deliberately NOT calendar.readonly, so the token cannot read the content of
# the private calendars at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts every stored credential at rest (AES-256-GCM): the Google refresh
# token and the SMTP password. 32 bytes as 64 hex characters:
#   openssl rand -hex 32
# Losing it costs one reconnect and one re-entered password, nothing else.
# Changing it is noticed and named rather than failing at an authentication tag.
#
# Renamed from GOOGLE_TOKEN_KEY in slice 10 — it is not Google's any more. If
# you have the old name in your .env, rename it and keep the value: the stored
# fingerprint then still matches and the Google connection stays as it is.
SECRET_KEY=

# Only needed on a server deployment — the loopback default is
# http://127.0.0.1:${PORT}/api/google/oauth/callback. It is the one thing that
# changes when this stops running on a Mac; nothing else in the software names
# a host.
# GOOGLE_REDIRECT_URI=

# ── Mail (slice 10) ──────────────────────────────────────────────────────────
# There is nothing to set here: the SMTP account lives in the practice settings
# and is entered in the application, because it is configuration and not
# deployment. The password is encrypted with SECRET_KEY above — the same
# mechanism as the Google refresh token, not a second one.
