{
  "name": "@praxi/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed/run.ts",
    "db:seed:services": "tsx src/db/seed/run-services.ts",
    "db:studio": "drizzle-kit studio",
    "files:orphans": "tsx src/scripts/files-orphans.ts",
    "invoices:verify": "tsx src/scripts/invoices-verify.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@hono/zod-validator": "0.9.0",
    "@node-rs/argon2": "2.0.2",
    "@praxi/shared": "workspace:*",
    "@react-pdf/renderer": "4.5.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "pdf-lib": "1.17.1",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "uuid": "13.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
