{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/patterns/DateField/**",
              "components/patterns/PageHeader/**",
              "components/patterns/ReadModeFieldset/**",
              "components/primitives/AlertDialog/**",
              "components/primitives/Badge/**",
              "components/primitives/Button/**",
              "components/primitives/Card/**",
              "components/primitives/Checkbox/**",
              "components/primitives/Input/**",
              "components/primitives/Label/**",
              "components/primitives/Popover/**",
              "components/primitives/Select/**",
              "components/primitives/Table/**",
              "components/primitives/Tabs/**",
              "components/primitives/Textarea/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Source Sans 3."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "AlertDialog": {
        "replaces": []
      },
      "Badge": {
        "replaces": []
      },
      "Button": {
        "replaces": []
