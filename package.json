{
  "name": "praxi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @praxi/shared build && concurrently -n shared,server,web -c magenta,cyan,green \"pnpm --filter @praxi/shared dev\" \"pnpm --filter @praxi/server dev\" \"pnpm --filter @praxi/web dev\"",
    "build": "pnpm -r build",
    "start": "node apps/server/dist/index.js",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @praxi/server db:generate",
    "db:migrate": "pnpm --filter @praxi/server db:migrate",
    "db:seed": "pnpm --filter @praxi/server db:seed",
    "db:seed:services": "pnpm --filter @praxi/server db:seed:services",
    "db:studio": "pnpm --filter @praxi/server db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "concurrently": "10.0.4",
    "typescript": "5.9.3"
  }
}
